# Mealhack environment variables. Copy to .env.local and fill in.
# The app runs fully on MOCK AI with none of these set.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- AI (Anthropic Claude) ---
# Leave unset to use the built-in mock. Set the key to enable real recognition
# + recipe generation. Force mock even with a key by setting MEALHACK_AI=mock.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
MEALHACK_AI=

# --- Supabase (Phase 2: accounts, storage, persistence) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Analytics / monitoring (optional) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Rate limiting (optional, durable) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
